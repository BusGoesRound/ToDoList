<Window x:Class="ToDoList.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        xmlns:local="clr-namespace:ToDoList"
        xmlns:UserControl="clr-namespace:ToDoList.UserControls"
        mc:Ignorable="d"
        Title="TestWindow" Height="450" Width="800"
        Background="{StaticResource BackgroundColor}">
    <Grid>
        <StackPanel Orientation="Horizontal">
            <RadioButton GroupName="MenuGroup" Content="Home" Style="{StaticResource Radio}" Checked="RadioButton_Checked"/>
            <RadioButton GroupName="MenuGroup" Content="Settings"/>
            <RadioButton GroupName="MenuGroup" Content="Profile"/>
        </StackPanel>
    </Grid>
</Window>
    