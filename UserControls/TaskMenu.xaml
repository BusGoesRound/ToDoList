<UserControl x:Class="ToDoList.UserControls.TaskMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ToDoList.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Border
        Background="{StaticResource BackgroundColor}"
        BorderBrush="{StaticResource ForegroundColor}"
        BorderThickness="2"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        Padding="5,3">
        <StackPanel>
            <RadioButton x:Name="RepeatDaily"
                GroupName="Repeat"
                Content="Repeat Daily"
                Click="SetDaily"
                Style="{StaticResource Radio}"/>
            <RadioButton x:Name="RepeatSpecific"
                GroupName="Repeat"
                Content="Repeat Specific"
                Click="OpenDaysWindow"
                Style="{StaticResource Radio}"/>

            <Popup x:Name="DOTWPOP"
                Opened="DOTWPOP_Opened">
                <local:DOTW x:Name="DOTWControl"/>
            </Popup>

        </StackPanel>
    </Border>
</UserControl>
