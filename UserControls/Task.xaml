<UserControl x:Class="ToDoList.UserControls.Task"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:ToDoList.UserControls"
    mc:Ignorable="d">

    <StackPanel
        Orientation="Horizontal"
        Margin="0,0,0,5">

        <!--Thumb
			Grid.Column="0"
            DragDelta="MoveTask"
			Cursor="ScrollNS"
				
			Height="20" Width="20">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Image Source="/Sprites/Grab Dots.png"
						Width="20" Height="20"/>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb-->

        <Button
            Margin="0,0,5,0"
			Grid.Column="1"
			Click="DeleteClicked">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Image Source="/Sprites/Garbage Can.png"
                            Width="20" Height="20"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button
            x:Name="MenuButton"

            Margin="0,0,5,0"
			Grid.Column="2"
			Click="MenuClicked">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Image Source="/Sprites/Menu Dots.png"
                        Height="20"
                        Width="10"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Popup x:Name="OverlayMenu"
               PlacementTarget="{Binding ElementName=MenuButton}"
               Placement="Bottom"
               StaysOpen="false"
               Opened="OverlayMenu_Opened">
            <local:TaskMenu x:Name="DotsMenu"/>
        </Popup>

        <Button
            Margin="0,0,5,0"
			Grid.Column="3"
			Click="CheckBoxClicked">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse
							Stroke="{StaticResource ForegroundColor}"
							StrokeThickness="3"
							Fill="Transparent"
							Width="20" Height="20"/>
                        <Ellipse
							Grid.Column="0"
							Fill="{Binding Path=DotColor}"
							Width="10" Height="10"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <TextBox
            x:Name="TaskTextBox"
            
			Grid.Column="4"
			Text="{Binding Path=TaskText}"
            d:Text="Task"
			FontSize="14"
					
			Foreground="{StaticResource TextColor}"
			Background="Transparent"
			CaretBrush="Black"
			SelectionBrush="#999999"
			BorderThickness="0">
        </TextBox>

    </StackPanel>
</UserControl>
