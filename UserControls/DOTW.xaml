<UserControl x:Class="ToDoList.UserControls.DOTW"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ToDoList.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border
        Background="{StaticResource BackgroundColor}"
        BorderBrush="{StaticResource ForegroundColor}"
        BorderThickness="2"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Padding="5">

        <StackPanel>
            <StackPanel x:Name="ButtonStack"
                Orientation="Horizontal" 
                Margin="0,0,0,5">

                <ToggleButton
                Style="{StaticResource Toggle}"

                Content="M"

                Width="20" Height="20"
                Margin="0,0,5,0"/>
                <ToggleButton
                Style="{StaticResource Toggle}"

                Content="T"

                Width="20" Height="20"
                Margin="0,0,5,0"/>
                <ToggleButton
                Style="{StaticResource Toggle}"

                Content="W"

                Width="20" Height="20"
                Margin="0,0,5,0"/>
                <ToggleButton
                Style="{StaticResource Toggle}"

                Content="T"

                Width="20" Height="20"
                Margin="0,0,5,0"/>
                <ToggleButton
                Style="{StaticResource Toggle}"

                Content="F"

                Width="20" Height="20"
                Margin="0,0,5,0"/>
                <ToggleButton
                Style="{StaticResource Toggle}"

                Content="S"

                Width="20" Height="20"
                Margin="0,0,5,0"/>
                <ToggleButton
                Style="{StaticResource Toggle}"

                Content="S"

                Width="20" Height="20"/>
            </StackPanel>
            <Button
                Content="Enter"
                HorizontalAlignment="Right"
                Click="Button_Click"
                Style="{StaticResource ButtonStyle}"/>
        </StackPanel>
    </Border>
</UserControl>
